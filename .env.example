# Copy this file to .env and fill it in. Never share .env.

# Where the app will live, e.g. live.yourdomain.com
# (add a DNS "A" record for it pointing to your server's IP)
DOMAIN=live.yourdomain.com

# Password for /admin (recordings, main angle, announcements)
ADMIN_PASSWORD=change-this-admin-password

# Password the camera phones type on /studio to go live
BROADCAST_PASSWORD=change-this-camera-password

# Port the app server listens on. Leave as is.
PORT=8080

# Most viewers who can watch at once. Extra people see "Full house"
# and join automatically when a spot opens.
MAX_VIEWERS=400

# Running from a laptop (start-event.bat): token of your Cloudflare Tunnel.
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create tunnel.
TUNNEL_TOKEN=
